# HRIS-Lite — copy ke .env sebelum docker compose up
# Generate secret: openssl rand -hex 32

# =============================================================================
# Mode A: Docker + SQLite (default, uji coba / staging kecil)
#   docker compose up -d --build
# =============================================================================
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,148.230.98.125
HRIS_SITE_URL=http://148.230.98.125:8080
HTTP_PORT=8080

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://148.230.98.125:8080,http://127.0.0.1:8080,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://148.230.98.125:8080,http://127.0.0.1:8080,http://localhost:8080

HRIS_FIELD_ENCRYPTION_KEY=generate-a-unique-32-char-secret-key
HRIS_AUDIT_ARCHIVE_DIR=/app/audit_archive
HRIS_DEFAULT_TENANT_SLUG=default

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hris.local

# Opsional: buat superuser otomatis saat container pertama kali jalan
# HRIS_BOOTSTRAP_SUPERUSER=admin
# HRIS_BOOTSTRAP_PASSWORD=Admin123456!

# =============================================================================
# Mode B: Docker + MySQL 8 (production VPS)
#   Comment baris SQLite di atas, uncomment blok di bawah
#   ./scripts/docker-up.sh mysql
#   DB_USER=hris (JANGAN root). DB_PASSWORD & MYSQL_ROOT_PASSWORD boleh sama.
# =============================================================================
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=hris_system
# DB_USER=hris
# DB_PASSWORD="your-db-password"
# DB_HOST=mysql
# DB_PORT=3306
# MYSQL_ROOT_PASSWORD="your-db-password"
# ALLOWED_HOSTS=your-server-ip,localhost,127.0.0.1
# HRIS_SITE_URL=http://your-server-ip:8080
# CSRF_TRUSTED_ORIGINS=http://your-server-ip:8080,http://127.0.0.1:8080
# CORS_ALLOWED_ORIGINS=http://your-server-ip:8080,http://127.0.0.1:8080
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
