# HRIS-Lite — copy ke .env sebelum docker compose up
# Generate secret: openssl rand -hex 32

# =============================================================================
# Mode A: Docker + SQLite (default, uji coba / staging kecil)
#   docker compose up -d --build
# =============================================================================
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,148.230.98.125
HRIS_SITE_URL=http://148.230.98.125:8080
HTTP_PORT=8080

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://148.230.98.125:8080,http://127.0.0.1:8080,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://148.230.98.125:8080,http://127.0.0.1:8080,http://localhost:8080
# Izinkan Flutter web dev (localhost:port acak) saat uji coba mobile di browser
CORS_ALLOW_FLUTTER_DEV=True

HRIS_FIELD_ENCRYPTION_KEY=generate-a-unique-32-char-secret-key-min-length
HRIS_MEDIA_PROTECTED=True
HRIS_MEDIA_URL_TTL_SECONDS=3600
LOG_LEVEL=INFO
DB_CONN_MAX_AGE=300
DRF_AUTH_THROTTLE=10/minute
HRIS_AUDIT_ARCHIVE_DIR=/app/audit_archive
HRIS_DEFAULT_TENANT_SLUG=default

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hris.local

# Opsional: buat superuser otomatis saat container pertama kali jalan
# HRIS_BOOTSTRAP_SUPERUSER=admin
# HRIS_BOOTSTRAP_PASSWORD=Admin123456!

# Mode C: ServBay local MySQL (macOS)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=bps_hris
# DB_USER=root
# DB_PASSWORD=your-servbay-mysql-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

#   Comment baris SQLite di atas, uncomment blok di bawah
#   ./scripts/docker-up.sh mysql
#   DB_USER=hris (JANGAN root). DB_PASSWORD & MYSQL_ROOT_PASSWORD boleh sama.
#   Scale worker saat lonjakan CI/CO: docker compose --profile mysql up -d --scale worker=3
# =============================================================================
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=hris_system
# DB_USER=hris
# DB_PASSWORD="your-db-password"
# DB_HOST=mysql
# DB_PORT=3306
# MYSQL_ROOT_PASSWORD="your-db-password"
# REDIS_URL=redis://redis:6379/0
# HRIS_PUNCH_ASYNC_RECALC=True
# GUNICORN_WORKERS=8
# GUNICORN_THREADS=4
# DRF_PUNCH_THROTTLE=30/minute
# ALLOWED_HOSTS=your-server-ip,localhost,127.0.0.1
# HRIS_SITE_URL=http://your-server-ip:8080
# CSRF_TRUSTED_ORIGINS=http://your-server-ip:8080,http://127.0.0.1:8080
# CORS_ALLOWED_ORIGINS=http://your-server-ip:8080,http://127.0.0.1:8080
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
