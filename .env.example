# HRIS-Lite — copy ke .env dan sesuaikan

# === Wajib production ===
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=hris.example.com,localhost
HRIS_SITE_URL=https://hris.example.com

# === MySQL (production) ===
DB_ENGINE=django.db.backends.mysql
DB_NAME=hris_lite
DB_USER=hris
DB_PASSWORD=strong-db-password
DB_HOST=mysql
DB_PORT=3306
# DB_SSL_CA=/path/to/ca.pem

# === Dev lokal (SQLite) — uncomment untuk development ===
# DEBUG=True
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# === Enkripsi field sensitif (NIK, rekening, gaji) ===
HRIS_FIELD_ENCRYPTION_KEY=generate-a-unique-32-char-secret-key

# === HTTPS (behind nginx) ===
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# === CORS (Flutter / mobile) ===
CORS_ALLOWED_ORIGINS=https://hris.example.com

HRIS_DEFAULT_TENANT_SLUG=default

# === Audit log ===
HRIS_AUDIT_RETENTION_DAYS=365
HRIS_AUDIT_LIST_DEFAULT_DAYS=90
HRIS_AUDIT_ARCHIVE_BATCH_SIZE=5000
HRIS_AUDIT_ARCHIVE_DIR=/var/hris/audit_archive

# === Email SMTP ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# === Dev email (console) ===
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
