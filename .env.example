# HRIS-Lite — copy ke .env sebelum docker compose up
# Generate secret: openssl rand -hex 32

# =============================================================================
# Mode A: Docker + SQLite (default, uji coba / staging kecil)
#   docker compose up -d --build
# =============================================================================
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip
HRIS_SITE_URL=http://localhost:8080
HTTP_PORT=8080

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HRIS_FIELD_ENCRYPTION_KEY=generate-a-unique-32-char-secret-key
HRIS_AUDIT_ARCHIVE_DIR=/app/audit_archive
HRIS_DEFAULT_TENANT_SLUG=default

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hris.local

# Opsional: buat superuser otomatis saat container pertama kali jalan
# HRIS_BOOTSTRAP_SUPERUSER=admin
# HRIS_BOOTSTRAP_PASSWORD=Admin123456!

# =============================================================================
# Mode B: Docker + MySQL 8 (production Ubuntu 24)
#   Uncomment blok MySQL di bawah, comment/hapus baris SQLite di atas
#   docker compose --profile mysql up -d --build
# =============================================================================
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=hris_lite
# DB_USER=hris
# DB_PASSWORD=strong-db-password
# DB_HOST=mysql
# DB_PORT=3306
# MYSQL_ROOT_PASSWORD=strong-root-password
# HRIS_SITE_URL=https://hris.example.com
# ALLOWED_HOSTS=hris.example.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://hris.example.com
# CORS_ALLOWED_ORIGINS=https://hris.example.com
# SECURE_HSTS_SECONDS=31536000
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
