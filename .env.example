# HRIS-Lite

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite dev (switch to PostgreSQL in production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hris_lite
# DB_USER=hris
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HRIS_DEFAULT_TENANT_SLUG=default
HRIS_SITE_URL=http://127.0.0.1:8000

# Audit log — simpan 365 hari di DB, UI default 90 hari; arsip via archive_audit_logs
HRIS_AUDIT_RETENTION_DAYS=365
HRIS_AUDIT_LIST_DEFAULT_DAYS=90
HRIS_AUDIT_ARCHIVE_BATCH_SIZE=5000
# HRIS_AUDIT_ARCHIVE_DIR=/var/hris/audit_archive

# Email (console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hris.local
