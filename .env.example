# HRIS-Lite — salin ke .env
# Generate secret: openssl rand -hex 32

# =============================================================================
# Development lokal (SQLite)
#   python3 -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt
#   cp .env.example .env && python manage.py migrate && python manage.py runserver
# =============================================================================
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
HRIS_SITE_URL=http://127.0.0.1:8000

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOW_FLUTTER_DEV=True

HRIS_FIELD_ENCRYPTION_KEY=generate-a-unique-32-char-secret-key-min-length
HRIS_MEDIA_PROTECTED=True
HRIS_MEDIA_URL_TTL_SECONDS=3600
LOG_LEVEL=INFO
DB_CONN_MAX_AGE=300
DRF_AUTH_THROTTLE=10/minute
HRIS_AUDIT_ARCHIVE_DIR=audit_archive
HRIS_DEFAULT_TENANT_SLUG=default
HRIS_ENABLE_ADMIN_CONSOLE=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hris.local

# =============================================================================
# Production VPS — lihat ops/native/env.production.example
#   cp ops/native/env.production.example .env
#   sudo ./scripts/native-deploy.sh
# =============================================================================

# DB_ENGINE=django.db.backends.mysql
# DB_NAME=hris_system
# DB_USER=hris
# DB_PASSWORD=your-db-password
# DB_HOST=127.0.0.1
# DB_PORT=3306
