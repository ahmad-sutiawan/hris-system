# Salin menjadi ops/docker/compose.env di server. File salinan tidak masuk git.
# Di VPS 148.230.103.122:
#   cd /var/www && git clone git@github.com:ahmad-sutiawan/hris-system.git
#   cd hris-system && git checkout develop
#   cp ops/docker/compose.env.example ops/docker/compose.env
#   nano ops/docker/compose.env
#   docker compose up -d --build
# Buka port 8020 di firewall VPS.
# openssl rand -hex 32   untuk SECRET_KEY dan HRIS_FIELD_ENCRYPTION_KEY

SECRET_KEY=change-me-openssl-rand-hex-32
HRIS_FIELD_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
DEBUG=False

ALLOWED_HOSTS=148.230.103.122,localhost,127.0.0.1
HRIS_PUBLIC_HOST=148.230.103.122
HRIS_PORT=8020
HRIS_SITE_URL=http://148.230.103.122:8020
HRIS_MOBILE_API_BASE_URL=http://148.230.103.122:8020/api/v1
CSRF_TRUSTED_ORIGINS=http://148.230.103.122:8020,http://127.0.0.1:8020,http://localhost:8020
CORS_ALLOWED_ORIGINS=http://148.230.103.122:8020,http://127.0.0.1:8020,http://localhost:8020
CORS_ALLOW_FLUTTER_DEV=False
CORS_ALLOW_ALL_ORIGINS=False

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

DB_ENGINE=django.db.backends.mysql
DB_NAME=hris_system
DB_USER=hris
DB_PASSWORD=change-me-db-password
DB_HOST=mysql
DB_PORT=3306
DB_CONN_MAX_AGE=60

MYSQL_DATABASE=hris_system
MYSQL_USER=hris
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

REDIS_URL=redis://redis:6379/0
HRIS_PUNCH_ASYNC_RECALC=True

HRIS_MEDIA_PROTECTED=True
HRIS_ENABLE_ADMIN_CONSOLE=False
HRIS_DEFAULT_TENANT_SLUG=default
HRIS_AUDIT_ARCHIVE_DIR=/app/audit_archive
LOG_LEVEL=INFO

HRIS_SUPERUSER=admin
HRIS_ADMIN_EMAIL=admin@hris.local
HRIS_ADMIN_PASSWORD=change-me-admin-password
