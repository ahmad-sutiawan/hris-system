# HRIS production — MySQL host, uvicorn 127.0.0.1:8001
#
# Deploy: sudo ./scripts/deploy.sh --fresh-db
# DB sengaja kosong — import dump terpisah jika perlu.
# Admin: createsuperuser manual (bukan bootstrap otomatis).

SECRET_KEY=change-me-openssl-rand-hex-32
HRIS_FIELD_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
DEBUG=False

HRIS_DOMAIN=hris.besibps.com
ACME_EMAIL=adminwebsite@besibps.com
ALLOWED_HOSTS=hris.besibps.com,148.230.98.125,localhost,127.0.0.1
HRIS_SITE_URL=https://hris.besibps.com
CSRF_TRUSTED_ORIGINS=https://hris.besibps.com
CORS_ALLOWED_ORIGINS=https://hris.besibps.com
CORS_ALLOW_FLUTTER_DEV=False
CORS_ALLOW_ALL_ORIGINS=False

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

DB_ENGINE=django.db.backends.mysql
DB_NAME=hris_system_v1
DB_USER=hris                    # jangan root — script --fresh-db buat user ini otomatis
DB_PASSWORD=password_kuat_anda  # password untuk user hris (bukan password login Linux)
DB_HOST=127.0.0.1
DB_PORT=3306

# Opsional: jika sudo mysql tanpa password tidak jalan, isi password root MySQL host
# MYSQL_ROOT_PASSWORD=

REDIS_URL=
HRIS_PUNCH_ASYNC_RECALC=False

HRIS_MEDIA_PROTECTED=True
HRIS_ENABLE_ADMIN_CONSOLE=False
HRIS_DEFAULT_TENANT_SLUG=default
HRIS_AUDIT_ARCHIVE_DIR=/var/www/hris-system/audit_archive
LOG_LEVEL=INFO
DB_CONN_MAX_AGE=300
