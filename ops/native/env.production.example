# Deploy: sudo ./scripts/deploy.sh --fresh-db
# DB sengaja kosong — import dump terpisah jika perlu.
# Admin: createsuperuser manual (bukan bootstrap otomatis).

SECRET_KEY=change-me-openssl-rand-hex-32
